# Copy to .env and fill in from the Lovable project's .env (Lovable → Code tab → .env).
# These are the Supabase *publishable* values for the Lovable Cloud backend; they are
# safe in a browser bundle but are kept out of git here so the backend can be swapped later.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
